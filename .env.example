# ===================================================================
# AI Based Code Validation 2.0 - Root Environment Configuration
# ===================================================================

# Server Port (Default: 5000)
PORT=5000

# CORS Allowed Origins (Comma-separated list of allowed frontend URLs)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5000,http://127.0.0.1:5000

# JWT Authentication Secret Key (Required for signing user session tokens)
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Institutional Faculty Secret Key (Required to register as Teacher/Faculty)
FACULTY_SECRET_KEY=JSPM-FACULTY-2026

# -------------------------------------------------------------------
# SMTP Email Configuration (For Real Email OTP Delivery)
# -------------------------------------------------------------------
# Standard SMTP settings (Supports Gmail, SendGrid, Amazon SES, Institutional SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM="JSPM BSIOTR AI Code Validator" <your_email@gmail.com>

# Backward-Compatible Gmail Specific Settings (Fallback if SMTP_* not set)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password

# -------------------------------------------------------------------
# Google Gemini AI API Key (Optional)
# -------------------------------------------------------------------
# If omitted or left blank, the platform automatically runs in its built-in
# semantic AST code evaluator & dynamic quiz generation mode.
GEMINI_API_KEY=
